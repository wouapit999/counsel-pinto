# Copy to .env.local and set ONE of the keys below.
# The app uses the first provider it finds a key for, in the order listed.
# Pin one explicitly with AI_PROVIDER if you set several.
#
# AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Recommended. Free, no card, AND it can search the web and cite sources.
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Free, no card. Fast, but NO web search — answers come from training data.
# ---------------------------------------------------------------------------

# https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# https://openrouter.ai/keys — free only on ":free" models
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# https://github.com/settings/tokens — needs the models:read scope
# GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Paid. Can search and cite. Pro subscribers get a monthly API credit.
# https://www.perplexity.ai/settings/api
# ---------------------------------------------------------------------------
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
